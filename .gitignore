# Dependencies
node_modules/

# Build output
dist/

# Database — accounts, sessions, saved routes and every visited cell.
# Created on first run at DB_PATH (defaults to ./data.db).
data.db
data.db-shm
data.db-wal
data.db-journal
*.sqlite
*.sqlite3

# Snapshots written by the server to BACKUP_DIR (defaults to ./backups)
backups/

# Personal location exports dropped here for `npm run import`
# (Google, Snapchat, Apple Photos, Strava, Komoot, GPX/KML/TCX …)
import/*
!import/.gitkeep

# Visited cells built from those exports by `npm run import` —
# derived from raw GPS points, so it is personal data too.
src/imported-cells.json

# Environment / secrets: REGISTRATION_CODE, HA_ALLOWED_HOSTS, ports, DB paths
.env
.env.*
!.env.example

# Generated map data. Committed by default so a clone runs without network:
#   npm run build:countries  → src/countries.json  (Natural Earth, public domain)
#   npm run build:places     → src/places.json     (GeoNames CC BY 4.0 + Natural Earth)
#   npm run build:regions    → src/regions.json    (Natural Earth admin-1)
#   npm run build:regions:hi → src/regions-hi.json (the same, at ~100 m; 8 MB)
# Uncomment to keep them out of the repo and rebuild locally instead. The fine
# region set is the one worth considering: it is 8 MB and only ever fetched by
# someone pinning Detail to Region and zooming in.
# src/countries.json
# src/places.json
# src/regions.json
# src/regions-hi.json

# Local Claude Code settings (personal permissions); .claude/ itself is shared
.claude/settings.local.json
.claude/worktrees/

# iCloud conflict copies ("main 2.js") — this project sits under a synced ~/Documents
* [0-9].*


# Logs
*.log
npm-debug.log*
yarn-error.log*

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editors
.vscode/
.idea/
*.swp

# Worktrees created by Claude Code sessions
.claude/worktrees/
